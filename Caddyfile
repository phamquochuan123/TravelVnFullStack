# CHƯA DÙNG. Service caddy trong docker-compose.yml đang bị tắt vì hệ thống chạy qua
# Cloudflare Quick Tunnel (cloudflared trỏ thẳng vào frontend:8080, bypass Caddy).
# Các security header khi chạy tunnel nằm ở "react travel manager/nginx.conf".
# File này chỉ dùng khi đã có domain/VPS thật — lúc đó thay IP bên dưới rồi bật lại
# service caddy và tắt cloudflared.
#
# Thay YOUR_SERVER_IP bằng IP thật của VPS, giữ nguyên phần .nip.io
# Ví dụ: nếu IP server là 1.2.3.4 thì dòng dưới là: 1.2.3.4.nip.io {
YOUR_SERVER_IP.nip.io {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    reverse_proxy frontend:8080
}
